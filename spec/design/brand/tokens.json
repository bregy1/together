{
  "$description": "Yaruno design tokens in the W3C Design Tokens (DTCG) format. Values from Romi's Yaruno Brand Guide v1.0 (November 2026); the source of truth is spec/design/tokens.md, and this file must match it. Generated 2026-11-09.",
  "color": {
    "$type": "color",
    "nacht": { "$value": "#0F1412", "$description": "Ground, 60 %" },
    "eis": { "$value": "#E8EEEA", "$description": "Text and wordmark, 30 %" },
    "mint": { "$value": "#7CF5C0", "$description": "The only accent, 10 %; a surface with nacht text" },
    "gletscherblau": { "$value": "#1D3A3F", "$description": "Image areas, secondary surfaces" },
    "nebel": { "$value": "#9BB0AC", "$description": "Secondary text, inactive icons" },
    "schiefer": { "$value": "#17201D", "$description": "Cards, input fields" },
    "linie": { "$value": "#2A3733", "$description": "Lines and dividers" },
    "senf": { "$value": "#F4C542", "$description": "Status: warning" },
    "koralle": { "$value": "#FF8A80", "$description": "Status: error" },
    "moos": { "$value": "#5F6E52", "$description": "Image placeholders" },
    "schiefer-blau": { "$value": "#3C4A5E", "$description": "Image placeholders" },
    "nebel-hell": { "$value": "#56635F", "$description": "Secondary text on light" },
    "weiss": { "$value": "#FFFFFF", "$description": "Cards in the daylight variant" }
  },
  "theme": {
    "$type": "color",
    "dark": {
      "$description": "Nacht look (default when the phone is in dark mode)",
      "background": { "$value": "{color.nacht}" },
      "card": { "$value": "{color.schiefer}" },
      "text": { "$value": "{color.eis}" },
      "textSecondary": { "$value": "{color.nebel}" },
      "surfaceSecondary": { "$value": "{color.gletscherblau}" },
      "accent": { "$value": "{color.mint}" },
      "onAccent": { "$value": "{color.nacht}" },
      "input": { "$value": "{color.schiefer}" },
      "inputBorder": { "$value": "{color.linie}" },
      "divider": { "$value": "{color.linie}" },
      "success": { "$value": "{color.mint}" },
      "warning": { "$value": "{color.senf}" },
      "error": { "$value": "{color.koralle}" },
      "hint": { "$value": "{color.nebel}" }
    },
    "light": {
      "$description": "Daylight look (when the phone is in light mode). Input and divider colours are not defined yet: waiting for Romi.",
      "background": { "$value": "{color.eis}" },
      "card": { "$value": "{color.weiss}" },
      "text": { "$value": "{color.nacht}" },
      "textSecondary": { "$value": "{color.nebel-hell}" },
      "surfaceSecondary": { "$value": "{color.gletscherblau}" },
      "accent": { "$value": "{color.mint}" },
      "onAccent": { "$value": "{color.nacht}" },
      "success": { "$value": "{color.mint}" },
      "warning": { "$value": "{color.senf}" },
      "error": { "$value": "{color.koralle}" },
      "hint": { "$value": "{color.nebel-hell}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "base": { "$value": ["Archivo", "Helvetica", "Arial", "sans-serif"], "$description": "Everything; file fonts/Archivo-VariableFont_wdth,wght.ttf" },
    "wordmark": { "$value": ["Fraunces", "serif"], "$description": "Wordmark and short mark only: weight 900, SOFT 100, opsz 144; file fonts/Fraunces-VariableFont_SOFT,WONK,opsz,wght.ttf" }
  },
  "text": {
    "$type": "typography",
    "hero": { "$value": { "fontFamily": "{font.base}", "fontSize": "56px", "lineHeight": 1.0, "fontWeight": 700, "letterSpacing": "-0.03em" } },
    "h1": { "$value": { "fontFamily": "{font.base}", "fontSize": "40px", "lineHeight": 1.02, "fontWeight": 700, "letterSpacing": "-0.03em" } },
    "h2": { "$value": { "fontFamily": "{font.base}", "fontSize": "32px", "lineHeight": 1.05, "fontWeight": 700, "letterSpacing": "-0.03em" } },
    "h3": { "$value": { "fontFamily": "{font.base}", "fontSize": "24px", "lineHeight": 1.1, "fontWeight": 600, "letterSpacing": "-0.03em" } },
    "cardTitle": { "$value": { "fontFamily": "{font.base}", "fontSize": "20px", "lineHeight": 1.1, "fontWeight": 600 } },
    "body": { "$value": { "fontFamily": "{font.base}", "fontSize": "16px", "lineHeight": 1.5, "fontWeight": 400 } },
    "small": { "$value": { "fontFamily": "{font.base}", "fontSize": "14px", "lineHeight": 1.45, "fontWeight": 400 } },
    "meta": { "$value": { "fontFamily": "{font.base}", "fontSize": "13px", "fontWeight": 400 } },
    "button": { "$value": { "fontFamily": "{font.base}", "fontSize": "18px", "fontWeight": 700 } },
    "label": { "$value": { "fontFamily": "{font.base}", "fontSize": "11px", "fontWeight": 600, "letterSpacing": "0.08em", "textTransform": "uppercase" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "7": { "$value": "32px" },
    "page": { "$value": "20px", "$description": "Side margin of a screen" }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": "999px" },
    "chip": { "$value": "999px" },
    "input": { "$value": "16px" },
    "card": { "$value": "24px" }
  },
  "size": {
    "$type": "dimension",
    "button": { "$value": "60px" },
    "buttonSmall": { "$value": "44px" },
    "chipMin": { "$value": "38px" },
    "chipMax": { "$value": "40px" },
    "input": { "$value": "56px" },
    "cardImage": { "$value": "150px" },
    "touchMin": { "$value": "44px" },
    "iconMin": { "$value": "20px" },
    "iconMax": { "$value": "24px" },
    "iconStroke": { "$value": "2px" },
    "logoMinWidth": { "$value": "90px" },
    "appIcon": { "$value": "1024px" }
  }
}
